# --- Ably-on-Centrifugo PoC wiring ---
# The committed PoC fixture key (config.ably-dev.json -> static-app.json)
ABLY_API_KEY=poc.key0:secret_key0_0123456789abcdef
# Point BOTH the agent (server-side) and the browser at the local adapter
ABLY_ENDPOINT=local-rest.ably.io
ABLY_PORT=8081
NEXT_PUBLIC_ABLY_ENDPOINT=local-rest.ably.io
NEXT_PUBLIC_ABLY_PORT=8081
# Deterministic mock model - no AI provider key needed
MOCK_LLM=1
